ARG NODE_IMAGE=node@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --gid 10001 cannabeats \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin cannabeats
COPY --chown=10001:10001 release/relay/server.mjs ./server.mjs
USER 10001:10001
EXPOSE 8080
CMD ["node", "server.mjs"]
