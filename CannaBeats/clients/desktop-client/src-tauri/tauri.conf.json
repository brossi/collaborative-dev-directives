{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CannaBeats Client",
  "version": "0.1.0",
  "identifier": "social.cannabeats.client",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CannaBeats Client",
        "width": 1040,
        "height": 760,
        "minWidth": 680,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Private CannaBeats game client",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
