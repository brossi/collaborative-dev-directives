[Unit]
Description=CannaBeats managed audio-source lease controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cannabeats-controller
Group=cannabeats-controller
SupplementaryGroups=cannabeats-diagnostics
WorkingDirectory=/opt/cannabeats-managed-source
Environment=PYTHONUNBUFFERED=1
Environment=CANNABEATS_AUDIO_SOURCE_API=https://poc.cannabeats.social/game/api/audio-source
Environment=CANNABEATS_AUDIO_SOURCE_TOKEN_FILE=/etc/cannabeats-managed-source/source-token
EnvironmentFile=-/etc/cannabeats-managed-source/source.env
Environment=CANNABEATS_PENDING_COMPLETION_FILE=/var/lib/cannabeats-controller/pending-completion.json
Environment=CANNABEATS_PUBLISHER_DIAGNOSTICS_SOCKET=/run/cannabeats-diagnostics/publisher.sock
Environment=CANNABEATS_DIAGNOSTIC_SOURCE_URL=https://poc.cannabeats.social/game/api/diagnostics/source-report
ExecStart=/usr/bin/python3 /opt/cannabeats-managed-source/controller.py
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/cannabeats-managed-source/source-token
ReadWritePaths=/var/lib/cannabeats-controller

[Install]
WantedBy=multi-user.target
