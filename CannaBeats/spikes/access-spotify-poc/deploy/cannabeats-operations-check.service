[Unit]
Description=Check CannaBeats component health
Requires=docker.service
After=docker.service
OnFailure=cannabeats-operations-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/cannabeats/backup.env
ExecStart=/usr/local/sbin/cannabeats-operations-check
TimeoutStartSec=90s
RuntimeMaxSec=90s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
