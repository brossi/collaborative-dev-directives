# Host-side scheduling configuration. This file contains no backup passphrase.
CANNABEATS_COMPOSE_DIR=/opt/cannabeats/CannaBeats/spikes/access-spotify-poc
CANNABEATS_BACKUP_KEEP=14
CANNABEATS_GAME_HISTORY_RETENTION_DAYS=90
CANNABEATS_BACKUP_TIMEOUT_SECONDS=1500
CANNABEATS_OPERATIONS_TIMEOUT_SECONDS=60
CANNABEATS_RELEASE_OVERRIDE=/var/lib/cannabeats/releases/current-compose.yaml
