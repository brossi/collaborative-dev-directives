# Host-side values for the first P2-managed release. Review rather than source blindly.
CANNABEATS_COMPOSE_DIR=/opt/cannabeats/CannaBeats/spikes/access-spotify-poc
CANNABEATS_RELEASE_DIR=/var/lib/cannabeats/releases
CANNABEATS_WEB_DIR=/opt/cannabeats/CannaBeats/web

# The audited P1 images accept the unversioned schema and the additive version-1 schema.
# TARGET must equal the PRAGMA user_version observed immediately before the release.
CANNABEATS_BOOTSTRAP_SCHEMA_MIN_VERSION=0
CANNABEATS_BOOTSTRAP_SCHEMA_MAX_VERSION=1
CANNABEATS_BOOTSTRAP_SCHEMA_TARGET_VERSION=0
