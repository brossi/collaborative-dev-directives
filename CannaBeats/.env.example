# Copy to .env (gitignored) and fill in from your Spotify developer
# dashboard app. Used ONLY by the Python tools (resolve_uris.py,
# playlists_to_mappings.py, playlist_to_songs.py) via the
# client-credentials flow.
#
# The CLIENT SECRET never goes anywhere near the iOS app or the repo.
# The client ID for the APP is separate plumbing: paste it into
# CannaBeats/Playback/SpotifyConfig.swift, or drop it in the gitignored
# file CannaBeats/Resources/SpotifyClientID.txt (see README).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
